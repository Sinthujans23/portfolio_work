{
  "name": "next-verify",
  "version": "1.0.0",
  "description": "CLI utility to verify Next.js build and runtime",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "verify-build": "ts-node src/cli/commands/verify-build.ts"
  },
  "bin": {
    "next-verify": "dist/index.js"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "commander": "^10.0.0",
    "execa": "^7.2.0",
    "axios": "^1.6.8",
    "cross-spawn": "^7.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "@types/node": "^20.11.0",
    "@types/commander": "^10.0.0",
    "@types/jest": "^29.5.12",
    "@types/axios": "^1.6.0"
  }
}
